<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ТЗ SYSTEM "tz.dtd">
<ТЗ> 
    <ОбщееОписание>
        <Наименование>Система бронирования отелей «HotelBooking»</Наименование> 
        <ПредметнаяОбласть> Гостиничный бизнес. Система предназначена для поиска, бронирования и управления номерами в отелях. Позволяет гостям находить свободные номера по датам и городу, оформлять брони, отменять их и оставлять отзывы. Администраторы управляют отелями, номерами и подтверждают брони. Менеджеры видят аналитику по загрузке и выручке. </ПредметнаяОбласть> 
        <Цель> Автоматизировать процесс бронирования номеров, исключить двойные брони на одни и те же даты, обеспечить разграничение доступа по ролям и ведение истории операций. </Цель> 
        <НазначениеОтзывов>Отзывы и рейтинги собираются для того, чтобы гости могли выбирать отель по рейтингу</НазначениеОтзывов>
        <Оплата>Все операции оплаты выполняются в транзакциях БД</Оплата>
        <МедиаВОтзывах>К отзыву можно прикреплять изображения и видео</МедиаВОтзывах>
        <Техподдержка>Реализован приватный диалог между гостем и менеджером</Техподдержка>
    </ОбщееОписание>
<Данные> 
    <Сущность ключ="PK"> 
        <Имя>roles</Имя> 
        <Описание>Справочник ролей пользователей</Описание> 
        <Атрибут первичный="да"> 
            <Имя>role_id</Имя> 
            <Тип>SERIAL</Тип> 
            <Ограничения>Первичный ключ, автоинкремент</Ограничения> 
        </Атрибут> 
        <Атрибут первичный="нет"> 
            <Имя>role_name</Имя> 
            <Тип>VARCHAR(20)</Тип> 
            <Ограничения>NOT NULL, UNIQUE, допустимые значения: guest, admin, manager</Ограничения> 
        </Атрибут> 
        <ОбщиеОграничения>Не более 3 записей (по числу ролей)</ОбщиеОграничения> 
    </Сущность>

    <Сущность ключ="PK">
        <Имя>users</Имя>
        <Описание>Зарегистрированные пользователи системы</Описание>
        <Атрибут первичный="да">
            <Имя>user_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ, автоинкремент</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>email</Имя>
            <Тип>VARCHAR(100)</Тип>
            <Ограничения>NOT NULL, UNIQUE, формат email</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>password_hash</Имя>
            <Тип>VARCHAR(255)</Тип>
            <Ограничения>NOT NULL, минимум 5 символов</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>full_name</Имя>
            <Тип>VARCHAR(100)</Тип>
            <Ограничения>NOT NULL</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>phone</Имя>
            <Тип>VARCHAR(20)</Тип>
            <Ограничения>Формат +7XXXXXXXXXX или NULL</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="roles.role_id">
            <Имя>role_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK на roles, ON DELETE RESTRICT</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>created_at</Имя>
            <Тип>TIMESTAMP</Тип>
            <Ограничения>DEFAULT NOW()</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Email уникален среди всех пользователей</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="hotels">
        <Имя>hotels</Имя>
        <Описание>Отели системы. Средний рейтинг рассчитывается автоматически на основе отзывов и используется для сортировки и выбора отеля гостями.</Описание>
        <Атрибут первичный="да">
            <Имя>hotel_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>name</Имя>
            <Тип>VARCHAR(100)</Тип>
            <Ограничения>NOT NULL</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>city</Имя>
            <Тип>VARCHAR(50)</Тип>
            <Ограничения>NOT NULL</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>address</Имя>
            <Тип>VARCHAR(200)</Тип>
            <Ограничения>NULL допустим</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>stars</Имя>
            <Тип>INT</Тип>
            <Ограничения>CHECK (stars BETWEEN 1 AND 5)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>description</Имя>
            <Тип>TEXT</Тип>
            <Ограничения>NULL допустим</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>avg_rating</Имя>
            <Тип>NUMERIC(3,2)</Тип>
            <Ограничения>DEFAULT NULL, обновляется триггером при изменении отзывов</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Название отеля уникально в пределах города; при сортировке по рейтингу отели без отзывов (avg_rating IS NULL) помещаются в конец</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="PK">
        <Имя>room_types</Имя>
        <Описание>Типы номеров внутри отеля</Описание>
        <Атрибут первичный="да">
            <Имя>room_type_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="hotels.hotel_id">
            <Имя>hotel_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK, ON DELETE CASCADE</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>type_name</Имя>
            <Тип>VARCHAR(50)</Тип>
            <Ограничения>NOT NULL</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>capacity</Имя>
            <Тип>INT</Тип>
            <Ограничения>CHECK (capacity > 0)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
        <Имя>base_price</Имя>
            <Тип>NUMERIC(10,2)</Тип>
            <Ограничения>CHECK (base_price > 0)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>description</Имя>
            <Тип>TEXT</Тип>
            <Ограничения>NULL допустим</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Название типа уникально в пределах отеля</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="PK">
        <Имя>rooms</Имя>
        <Описание>Конкретные физические номера</Описание>
        <Атрибут первичный="да">
            <Имя>room_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="room_types.room_type_id">
            <Имя>room_type_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK, ON DELETE CASCADE</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>room_number</Имя>
            <Тип>VARCHAR(10)</Тип>
            <Ограничения>NOT NULL, UNIQUE вместе с room_type_id</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>floor</Имя>
            <Тип>INT</Тип>
            <Ограничения>CHECK (floor >= 1)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>status</Имя>
            <Тип>VARCHAR(20)</Тип>
            <Ограничения>DEFAULT 'available', CHECK IN ('available','maintenance', 'booked')</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Номер не может быть забронирован, если status='maintenance' или status='booked'</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="PK">
        <Имя>bookings</Имя>
        <Описание>Бронирования номеров</Описание>
        <Атрибут первичный="да">
            <Имя>booking_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="users.user_id">
            <Имя>user_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK, ON DELETE RESTRICT</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="rooms.room_id">
            <Имя>room_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK, ON DELETE RESTRICT</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>check_in_date</Имя>
            <Тип>DATE</Тип>
            <Ограничения>NOT NULL, не раньше текущей даты</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>check_out_date</Имя>
            <Тип>DATE</Тип>
            <Ограничения>NOT NULL, CHECK (check_out_date > check_in_date)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>guests_count</Имя>
            <Тип>INT</Тип>
            <Ограничения>CHECK (guests_count > 0)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>total_price</Имя>
            <Тип>NUMERIC(10,2)</Тип>
            <Ограничения>NOT NULL, CHECK (total_price >= 0)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>status</Имя>
            <Тип>VARCHAR(20)</Тип>
            <Ограничения>DEFAULT 'pending', CHECK IN ('pending','confirmed','cancelled','completed')</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>created_at</Имя>
            <Тип>TIMESTAMP</Тип>
            <Ограничения>DEFAULT NOW()</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>
            Интервалы [check_in, check_out) одного номера не должны пересекаться
            для броней со статусом pending или confirmed
        </ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="payments">
        <Имя>payments</Имя>
        <Описание>Платежи по бронированиям. Все операции выполняются в транзакциях БД для гарантии согласованности.</Описание>
        <Атрибут первичный="да">
            <Имя>payment_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ, автоинкремент</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="bookings">
            <Имя>booking_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK на bookings(booking_id), ON DELETE CASCADE</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>amount</Имя>
            <Тип>NUMERIC(10,2)</Тип>
            <Ограничения>CHECK (amount > 0)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>method</Имя>
            <Тип>VARCHAR(20)</Тип>
            <Ограничения>CHECK IN ('card','cash','online')</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>status</Имя>
            <Тип>VARCHAR(20)</Тип>
            <Ограничения>DEFAULT 'pending', CHECK IN ('pending','paid','refunded')</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>paid_at</Имя>
            <Тип>TIMESTAMP</Тип>
            <Ограничения>NULL, если не оплачен</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>transaction_id</Имя>
            <Тип>VARCHAR(64)</Тип>
            <Ограничения>UNIQUE, NULL, идентификатор транзакции платёжной системы</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>refunded_at</Имя>
            <Тип>TIMESTAMP</Тип>
            <Ограничения>NULL, заполняется при возврате</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Сумма платежей со статусом 'paid' по брони не превышает bookings.total_price; возврат возможен только для оплаченного платежа; все операции — в транзакции с блокировкой строки брони (SELECT … FOR UPDATE)</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="PK">
        <Имя>services</Имя>
        <Описание>Дополнительные услуги отеля</Описание>
        <Атрибут первичный="да">
            <Имя>service_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>name</Имя>
            <Тип>VARCHAR(50)</Тип>
            <Ограничения>NOT NULL, UNIQUE</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>price</Имя>
            <Тип>NUMERIC(10,2)</Тип>
            <Ограничения>CHECK (price > 0)</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Название услуги уникально</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="PK">
        <Имя>booking_services</Имя>
        <Описание>Связь брони и дополнительных услуг (M:N)</Описание>
        <Атрибут первичный="да" внешний="bookings.booking_id">
            <Имя>booking_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>Часть составного PK, FK, ON DELETE CASCADE</Ограничения>
        </Атрибут>
        <Атрибут первичный="да" внешний="services.service_id">
            <Имя>service_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>Часть составного PK, FK</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>quantity</Имя>
            <Тип>INT</Тип>
            <Ограничения>DEFAULT 1, CHECK (quantity > 0)</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Пара (booking_id, service_id) уникальна</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="reviews">
        <Имя>reviews</Имя>
        <Описание>Отзывы гостей об отелях. Используются для расчёта среднего рейтинга отеля, по которому другие пользователи выбирают отель.</Описание>
        <Атрибут первичный="да">
            <Имя>review_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ, автоинкремент</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="users">
            <Имя>user_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK на users(user_id)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="hotels">
            <Имя>hotel_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK на hotels(hotel_id)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>rating</Имя>
            <Тип>INT</Тип>
            <Ограничения>CHECK (rating BETWEEN 1 AND 5)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>comment</Имя>
            <Тип>TEXT</Тип>
            <Ограничения>NULL допустим</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>created_at</Имя>
            <Тип>TIMESTAMP</Тип>
            <Ограничения>DEFAULT NOW()</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Один пользователь может оставить один отзыв на отель; средний рейтинг отеля рассчитывается как AVG(rating) по всем отзывам</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="review_media">
      <Имя>review_media</Имя>
      <Описание>Медиафайлы (изображения и видео), прикреплённые к отзывам</Описание>
      <Атрибут первичный="да">
        <Имя>media_id</Имя>
        <Тип>SERIAL</Тип>
        <Ограничения>Первичный ключ</Ограничения>
      </Атрибут>
      <Атрибут первичный="нет" внешний="reviews">
        <Имя>review_id</Имя>
        <Тип>INT</Тип>
        <Ограничения>NOT NULL, FK, ON DELETE CASCADE</Ограничения>
      </Атрибут>
      <Атрибут первичный="нет">
        <Имя>media_type</Имя>
        <Тип>VARCHAR(10)</Тип>
        <Ограничения>NOT NULL, CHECK IN ('image','video')</Ограничения>
      </Атрибут>
      <Атрибут первичный="нет">
        <Имя>file_path</Имя>
        <Тип>VARCHAR(255)</Тип>
        <Ограничения>NOT NULL</Ограничения>
      </Атрибут>
      <ОбщиеОграничения>Не более 10 медиафайлов на отзыв; допустимые форматы: jpeg, png, webp, mp4, webm; макс. размер 50 МБ</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="support_dialogs">
        <Имя>support_dialogs</Имя>
        <Описание>Приватные диалоги технической поддержки между гостем и менеджером системы. Другие пользователи не видят содержимое диалога.</Описание>
        <Атрибут первичный="да">
            <Имя>dialog_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ, автоинкремент</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="users">
            <Имя>user_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK на users(user_id), ON DELETE CASCADE, автор обращения (гость)</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет" внешний="users">
            <Имя>manager_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NULL, FK на users(user_id), назначается при первом ответе менеджера</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>subject</Имя>
            <Тип>VARCHAR(150)</Тип>
            <Ограничения>NOT NULL, тема обращения</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>status</Имя>
            <Тип>VARCHAR(20)</Тип>
            <Ограничения>DEFAULT 'open', CHECK IN ('open','in_progress','closed')</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>created_at</Имя>
            <Тип>TIMESTAMP</Тип>
            <Ограничения>DEFAULT NOW()</Ограничения>
        </Атрибут>
        <Атрибут первичный="нет">
            <Имя>closed_at</Имя>
            <Тип>TIMESTAMP</Тип>
            <Ограничения>NULL, заполняется при закрытии диалога</Ограничения>
        </Атрибут>
        <ОбщиеОграничения>Диалог виден только автору обращения, назначенному менеджеру и менеджерам системы; один гость может иметь несколько диалогов</ОбщиеОграничения>
    </Сущность>

    <Сущность ключ="support_messages">
        <Имя>support_messages</Имя>
        <Описание>Отдельные сообщения внутри диалога технической поддержки. Видны только участникам диалога.</Описание>

        <Атрибут первичный="да">
            <Имя>message_id</Имя>
            <Тип>SERIAL</Тип>
            <Ограничения>Первичный ключ, автоинкремент</Ограничения>
        </Атрибут>

        <Атрибут первичный="нет" внешний="support_dialogs">
            <Имя>dialog_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK на support_dialogs(dialog_id), ON DELETE CASCADE</Ограничения>
        </Атрибут>

        <Атрибут первичный="нет" внешний="users">
            <Имя>sender_id</Имя>
            <Тип>INT</Тип>
            <Ограничения>NOT NULL, FK на users(user_id), автор сообщения (гость или менеджер)</Ограничения>
        </Атрибут>

        <Атрибут первичный="нет">
            <Имя>body</Имя>
            <Тип>TEXT</Тип>
            <Ограничения>NOT NULL, минимум 1 символ</Ограничения>
        </Атрибут>

        <Атрибут первичный="нет">
            <Имя>created_at</Имя>
            <Тип>TIMESTAMP</Тип>
            <Ограничения>DEFAULT NOW()</Ограничения>
        </Атрибут>

        <Атрибут первичный="нет">
            <Имя>is_read</Имя>
            <Тип>BOOLEAN</Тип>
            <Ограничения>DEFAULT FALSE, флаг прочтения получателем</Ограничения>
        </Атрибут>

        <ОбщиеОграничения>Доступ к сообщениям имеют только участники диалога (user_id, manager_id) и менеджеры системы; при закрытии диалога новые сообщения запрещены</ОбщиеОграничения>
    </Сущность>


</Данные>

<ПользовательскиеРоли> 
    <Роль> 
        <Наименование>Гость</Наименование> 
        <Ответственность> Поиск свободных номеров, создание брони, отмена своей брони, просмотр своих броней, оплата, оставление отзыва после выезда. </Ответственность> 
        <КоличествоПользователей>Не ограничено (роль по умолчанию при регистрации)</КоличествоПользователей> 
        <UI> Консольное меню: поиск номеров, мои брони, отмена брони, оставить отзыв. Видит только свои данные. </UI> 
    </Роль> 
    <Роль> 
        <Наименование>Администратор отеля</Наименование> 
        <Ответственность> Подтверждение и отклонение броней, управление номерами (добавление, перевод в maintenance), изменение цен типов номеров, просмотр броней по своему отелю. </Ответственность> 
        <КоличествоПользователей>1–3 на отель</КоличествоПользователей> 
        <UI> Консольное меню: список броней, подтверждение, управление номерами и типами номеров. </UI> 
    </Роль> 
    <Роль> 
        <Наименование>Менеджер системы</Наименование> 
        <Ответственность> Управление отелями и пользователями, просмотр аналитики (загрузка отелей, выручка за период), назначение ролей. </Ответственность> 
        <КоличествоПользователей>1–2</КоличествоПользователей> 
        <UI> Консольное меню: CRUD отелей, отчёты, управление пользователями. </UI> 
    </Роль> 
</ПользовательскиеРоли>

<ТехнологияРазработки> 
    <ЯзыкПрограммирования>Python 3.10+</ЯзыкПрограммирования> 
    <СУБД>PostgreSQL 14+</СУБД> 
    <Библиотеки> psycopg2-binary (драйвер PostgreSQL), tabulate (вывод таблиц), colorama (цветной вывод), python-dotenv (конфигурация), pytest (тестирование) </Библиотеки> 
    <Архитектура> Слоистая: UI (консольные меню) → DAO (доступ к данным) → PostgreSQL. Вспомогательный слой helpers для ввода/вывода. </Архитектура> 
</ТехнологияРазработки>

<ФункциональныеТребования>
    <ОплатаТранзакции>
        <Пункт>Все операции оплаты выполняются в транзакции с блокировкой строки брони (SELECT … FOR UPDATE)</Пункт>
        <Пункт>Проверяется: бронь существует, принадлежит пользователю, статус pending/confirmed, сумма не превышает total_price</Пункт>
        <Пункт>При успешной оплате создаётся запись в payments со статусом paid, paid_at = NOW()</Пункт>
        <Пункт>При отмене оплаченной брони создаётся возврат: status=refunded, refunded_at=NOW() — в одной транзакции</Пункт>
        <Пункт>При любой ошибке — ROLLBACK, данные не меняются</Пункт>
    </ОплатаТранзакции>

    <МедиаВОтзывахТребования>
        <Пункт>Гость может прикрепить к отзыву до 10 файлов (изображения и видео)</Пункт>
        <Пункт>Проверяются MIME-тип и размер файла; при несоответствии — ошибка</Пункт>
        <Пункт>При удалении отзыва медиа удаляются каскадно, файлы удаляются с диска</Пункт>
        <Пункт>В карточке отеля отображается средний рейтинг и количество отзывов</Пункт>
    </МедиаВОтзывахТребования>

    <ТехподдержкаТребования>
        <Пункт>Гость может создать обращение (тема + первое сообщение)</Пункт>
        <Пункт>Сообщения видны только автору, назначенному менеджеру и менеджерам системы</Пункт>
        <Пункт>Другие пользователи не видят диалог</Пункт>
        <Пункт>Менеджер может отвечать и менять статус (open → in_progress → closed)</Пункт>
    </ТехподдержкаТребования>

    <РейтингСортировка>
        <Пункт>Средний рейтинг отеля рассчитывается как AVG(rating) по всем отзывам</Пункт>
        <Пункт>В поиске доступна сортировка по цене (возр./убыв.) по минимальной base_price</Пункт>
        <Пункт>В поиске доступна сортировка по рейтингу (убыв./возр.)</Пункт>
        <Пункт>Отели без отзывов отображаются с рейтингом «—» и в конце при сортировке по рейтингу</Пункт>
    </РейтингСортировка>
</ФункциональныеТребования>

<Тестирование> 
    <ВидыТестирования> Модульное (pytest) для DAO-функций, интеграционное для сценариев бронирования, ручное тестирование меню. </ВидыТестирования> 
    <ТестовыеСценарии> 
        <Сценарий> 
            <Название>Успешное бронирование свободного номера</Название> 
            <Шаги> Войти как гость → выбрать отель → ввести даты 2025-07-01..2025-07-05 → выбрать номер → подтвердить. </Шаги> 
            <ОжидаемыйРезультат> Создана запись в bookings со статусом pending, total_price рассчитан как 4 × base_price. </ОжидаемыйРезультат> 
        </Сценарий> 
        <Сценарий>
            <Название>Отказ при пересечении дат</Название> 
            <Шаги> Попытаться забронировать тот же номер на 2025-07-03..2025-07-08. </Шаги> 
            <ОжидаемыйРезультат> Ошибка «Номер уже занят на эти даты», запись не создаётся. </ОжидаемыйРезультат> 
        </Сценарий> 
            <Сценарий> 
                <Название>Запрет брони на номер в ремонте</Название> 
                <Шаги> Попытаться забронировать номер со status='maintenance'. </Шаги> 
                <ОжидаемыйРезультат> Триггер БД выбрасывает исключение, бронь не создаётся. </ОжидаемыйРезультат> 
            </Сценарий> 
            <Сценарий> 
                <Название>Отмена брони</Название> 
                <Шаги> Гость отменяет свою бронь по booking_id. </Шаги> 
                <ОжидаемыйРезультат> Статус брони становится cancelled, номер снова доступен на эти даты. </ОжидаемыйРезультат> 
            </Сценарий> 
            <Сценарий>
                <Название>Разграничение доступа</Название> 
                <Шаги> Гость пытается отменить чужую бронь, указав чужой booking_id. </Шаги> 
                <ОжидаемыйРезультат> Операция не выполняется (0 затронутых строк), сообщение об ошибке. </ОжидаемыйРезультат> 
            </Сценарий>
        </ТестовыеСценарии> 
    </Тестирование> 
</ТЗ>
