<!ELEMENT ТЗ (ОбщееОписание, Данные, ПользовательскиеРоли, ТехнологияРазработки, ФункциональныеТребования, Тестирование)>

<!ELEMENT ОбщееОписание (Наименование, ПредметнаяОбласть, Цель, НазначениеОтзывов, Оплата, МедиаВОтзывах, Техподдержка)>
<!ELEMENT Наименование (#PCDATA)>
<!ELEMENT ПредметнаяОбласть (#PCDATA)>
<!ELEMENT Цель (#PCDATA)>
<!ELEMENT НазначениеОтзывов (#PCDATA)>
<!ELEMENT Оплата (#PCDATA)>
<!ELEMENT МедиаВОтзывах (#PCDATA)>
<!ELEMENT Техподдержка (#PCDATA)>

<!ELEMENT Данные (Сущность+)>
<!ELEMENT Сущность (Имя, Описание, Атрибут+, ОбщиеОграничения?)>
<!ATTLIST Сущность ключ CDATA #REQUIRED>
<!ELEMENT Имя (#PCDATA)>
<!ELEMENT Описание (#PCDATA)>
<!ELEMENT Атрибут (Имя, Тип, Ограничения)>
<!ATTLIST Атрибут первичный (да|нет) #REQUIRED>
<!ATTLIST Атрибут внешний CDATA #IMPLIED>
<!ELEMENT Тип (#PCDATA)>
<!ELEMENT Ограничения (#PCDATA)>
<!ELEMENT ОбщиеОграничения (#PCDATA)>

<!ELEMENT ПользовательскиеРоли (Роль+)>
<!ELEMENT Роль (Наименование, Ответственность, КоличествоПользователей, UI)>
<!ELEMENT Ответственность (#PCDATA)>
<!ELEMENT КоличествоПользователей (#PCDATA)>
<!ELEMENT UI (#PCDATA)>

<!ELEMENT ТехнологияРазработки (ЯзыкПрограммирования, СУБД, Библиотеки, Архитектура, ДополнительныеБиблиотеки?)>
<!ELEMENT ЯзыкПрограммирования (#PCDATA)>
<!ELEMENT СУБД (#PCDATA)>
<!ELEMENT Библиотеки (#PCDATA)>
<!ELEMENT Архитектура (#PCDATA)>
<!ELEMENT ДополнительныеБиблиотеки (#PCDATA)>

<!ELEMENT ФункциональныеТребования (ОплатаТранзакции, МедиаВОтзывахТребования, ТехподдержкаТребования, РейтингСортировка)>
<!ELEMENT ОплатаТранзакции (Пункт+)>
<!ELEMENT МедиаВОтзывахТребования (Пункт+)>
<!ELEMENT ТехподдержкаТребования (Пункт+)>
<!ELEMENT РейтингСортировка (Пункт+)>
<!ELEMENT Пункт (#PCDATA)>

<!ELEMENT Тестирование (ВидыТестирования, ТестовыеСценарии)>
<!ELEMENT ВидыТестирования (#PCDATA)>
<!ELEMENT ТестовыеСценарии (Сценарий+)>
<!ELEMENT Сценарий (Название, Шаги, ОжидаемыйРезультат)>
<!ELEMENT Название (#PCDATA)>
<!ELEMENT Шаги (#PCDATA)>
<!ELEMENT ОжидаемыйРезультат (#PCDATA)>
